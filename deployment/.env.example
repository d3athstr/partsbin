# PartsBin backend environment (/opt/partsbin/backend/.env, root:deploy 640)
# Secrets sourced from Vault at deploy: secret/<org>/partsbin/*

# --- Flask ---
FLASK_APP=run.py
FLASK_ENV=production
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# --- Database ---
DATABASE_URL=postgresql://partsbin:change-me@localhost/partsbin

# --- TOTP secret encryption ---
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me
TOTP_ISSUER_NAME=PartsBin

# --- WebAuthn (passkeys) ---
WEBAUTHN_RP_ID=parts.example.com
WEBAUTHN_RP_NAME=PartsBin
# Optional origin override; defaults to https://<WEBAUTHN_RP_ID>
#WEBAUTHN_ORIGIN=https://parts.example.com

# --- URLs / CORS ---
SITE_URL=https://parts.example.com
CORS_ORIGINS=https://parts.example.com

# --- Uploads ---
UPLOAD_FOLDER=/opt/partsbin/uploads
MAX_IMAGE_SIZE=5242880
MAX_PDF_SIZE=26214400
MAX_FILE_SIZE=52428800

# --- SMTP relay ---
SMTP_HOST=smtp.internal
SMTP_PORT=25
SMTP_FROM=parts@example.com

# --- Email ingestion: Google OAuth (reuses Empire12 Voice GCP client) ---
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REDIRECT_URI=https://parts.example.com/api/oauth/callback
# Per-account token store + runtime state (root/deploy only)
PARTSBIN_GOOGLE_TOKENS=/etc/partsbin/google-tokens.json
PARTSBIN_INGEST_STATE=/etc/partsbin/ingest-state.json
# Gmail accounts to poll (token store keys)
INGEST_ACCOUNTS=don,deanna
# Key gating /api/oauth/login/<user>?key= and /api/ingest re-auth links
INGEST_KEY=change-me
# Secondary mailbox that auto-forwards vendor order mail into the polled Gmail
# account. Forwards carry THIS address in From, not the vendor's, so several
# vendor terms in the query are inert without it. Leave unset to disable.
INGEST_FORWARD_ADDRESS=change-me@example.com
# Fallback re-auth notification addresses (used when a token has no stored email)
#REAUTH_EMAIL_DON=change-me
#REAUTH_EMAIL_DEANNA=change-me

# --- Claude API (email parsing) ---
ANTHROPIC_API_KEY=change-me
PARTSBIN_CLAUDE_MODEL=claude-sonnet-5
